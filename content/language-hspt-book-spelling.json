  "studyRules": [
    {
      "title": "Vowel combinations and exceptions",
      "notes": "Review patterns for ie/ei; do not rely on an exception-free rhyme. Include receive, receipt, science, weird, feisty, leisure and protein."
    },
    {
      "title": "Plurals",
      "notes": "Practice s/es, -y changing to -ies after a consonant, and selected -o plural exceptions."
    },
    {
      "title": "Prefixes",
      "notes": "Practice anti-, dis-, mis-, un-, pre-, re- and related prefixes without changing the base word unnecessarily."
    },
    {
      "title": "Suffixes",
      "notes": "Practice -ness, -ful, -less, -ment, -ly, -able, -ible, -ed, -ing and changes to terminal e or y."
    },
    {
      "title": "Doubled letters",
      "notes": "Pay attention to pairs in accommodate, aggressive, occurrence, unnecessary and other longer words."
    },
    {
      "title": "Sound-alike distractors",
      "notes": "Spot plausible but incorrect spellings such as libary for library or wierd for weird."
    }
  ]
